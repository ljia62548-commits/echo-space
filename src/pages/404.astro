---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="这一页不存在。">
  <div class="not-found">
    <p class="not-found__code">ERROR 404 / SIGNAL LOST</p>
    <h1>这里没有回声。</h1>
    <p>
      你访问的页面可能被移动、删除了，或者从来没有存在过。
      可以回到首页，或者去归档里随便翻翻。
    </p>
    <div class="not-found__actions">
      <a class="btn btn--solid" href="/">回到首页</a>
      <a class="btn" href="/archive/">浏览归档</a>
    </div>
  </div>
</BaseLayout>
