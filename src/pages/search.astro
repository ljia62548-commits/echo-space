---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, getCategoryLabel, getPostSlug } from '../lib/content';

const posts = await getPublishedPosts();

const index = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  categoryLabel: getCategoryLabel(post.data.category),
  tags: post.data.tags,
  url: `/${post.data.category}/${getPostSlug(post)}/`,
  date: post.data.date.toISOString(),
}));

const json = JSON.stringify(index).replace(/</g, '\\u003c');
---

<BaseLayout title="Search" description="搜索 Echo Space 的文章。">
  <div class="page">
    <header class="page__head">
      <p class="page__index">INDEX / SEARCH</p>
      <h1 class="page__title">Find a <em>thought</em></h1>
      <p class="page__lede">输入一个词。它可能出现在标题、摘要、标签，或者某个我已经忘记的句子里。</p>
    </header>

    <div class="page__body">
      <div class="search-form">
        <label class="mono" for="site-search" style="display:block; margin-bottom:12px; color:var(--faint);">
          Search the archive
        </label>
        <input
          class="search-input"
          id="site-search"
          type="search"
          placeholder="试试「注意力」或「AI」"
          autocomplete="off"
          data-search-input
        />
        <p class="search-status" data-search-status>正在加载索引…</p>
      </div>

      <div class="search-results" data-search-results></div>
    </div>
  </div>

  <script type="application/json" id="search-index" set:html={json} />
</BaseLayout>
