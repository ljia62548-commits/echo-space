---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout bodyClass="page-home">
  <Hero />

  <section class="memo-section" aria-label="待办便签" data-reveal>
    <div class="memo-board" data-memo-board>
      <form class="memo-form" data-memo-form>
        <label class="sr-only" for="memo-input">添加待办</label>
        <input
          class="memo-form__input"
          id="memo-input"
          type="text"
          placeholder="添加待办"
          maxlength="120"
          autocomplete="off"
          data-memo-input
        />
        <button class="memo-form__button" type="submit" aria-label="添加待办">+</button>
      </form>

      <ul class="memo-list" data-memo-list></ul>
    </div>
  </section>
</BaseLayout>
