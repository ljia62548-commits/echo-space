---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';

const links = profile.links as Array<{ label: string; href: string }>;
const hasAvatar = Boolean(profile.avatar);
---

<BaseLayout
  title="About Me"
  description={`关于 ${profile.name}：${profile.headline}。${profile.intro}`}
>
  <div class="page">
    <section class="about-hero" aria-labelledby="about-name">
      <div class="portrait" data-reveal>
        <span class="portrait__monogram" aria-hidden="true">{profile.monogram}</span>
        {hasAvatar && <img src={profile.avatar} alt={`${profile.name} 的照片`} onerror="this.remove()" />}
      </div>

      <div class="about-intro" data-reveal>
        <h1 class="about-name" id="about-name">{profile.name}</h1>
        <p class="about-headline">{profile.headline}</p>
        <p class="about-lede">{profile.intro}</p>
      </div>
    </section>

    <div class="about-sections">
      <section class="about-section" aria-label="关于我">
        <div class="about-bio">
          {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="about-section" aria-label="现在">
        <div class="now-table">
          <div class="now-table__row">
            <span class="now-table__key">Building</span>
            <span class="now-table__value">{profile.now.building}</span>
          </div>
          <div class="now-table__row">
            <span class="now-table__key">Learning</span>
            <span class="now-table__value">{profile.now.learning}</span>
          </div>
          <div class="now-table__row">
            <span class="now-table__key">Playing</span>
            <span class="now-table__value">{profile.now.playing}</span>
          </div>
        </div>
      </section>

      {
        profile.toolbox.length > 0 && (
          <section class="about-section" aria-label="工具箱">
            <div class="toolbox">
              {profile.toolbox.map((group) => (
                <div class="toolbox__group">
                  <h3>{group.group}</h3>
                  <div class="toolbox__items">
                    {group.items.map((item) => <span class="tag">{item}</span>)}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <section class="about-section" aria-label="时间线">
        <div class="timeline">
          {
            profile.timeline.map((item) => (
              <div class="timeline__item">
                <span class="timeline__date">{item.date}</span>
                <div>
                  <p class="timeline__title">{item.title}</p>
                  <p class="timeline__desc">{item.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="about-section" aria-label="兴趣">
        <div class="interest-list">
          {profile.interests.map((interest) => <span class="tag">{interest}</span>)}
        </div>
      </section>

      <section class="about-section" aria-label="找到我">
        <div class="link-list">
          {links.map((link) => (
            <a href={link.href} target="_blank" rel="me noopener">{link.label} ↗</a>
          ))}
          <a href="/rss.xml">RSS Feed ↗</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
