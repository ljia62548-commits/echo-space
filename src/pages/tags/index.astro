---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getAllTags} from '../../lib/content';

const tags = await getAllTags();
---

<BaseLayout title="Tags" description="Echo Space 的全部标签。">
  <div class="page">
    <header class="page__head">
      <p class="page__index">INDEX / TAGS</p>
      <h1 class="page__title">Threads of <em>thought</em></h1>
      <p class="page__lede">一些反复出现的词。它们不一定重要，但确实构成了这里的地形。</p>
      <div class="page__meta">
        <span>{String(tags.length).padStart(2, '0')} tags</span>
        <a class="text-link" href="/archive/">Archive</a>
      </div>
    </header>

    <div class="page__body">
      <div class="tag-index">
        {
          tags.map(({ tag, count }) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`}>
              <span class="tag-index__name">#{tag}</span>
              <span class="tag-index__count">{String(count).padStart(2, '0')}</span>
            </a>
          ))
        }
      </div>
      {tags.length === 0 && <p class="empty-state">还没有标签。</p>}
    </div>
  </div>
</BaseLayout>
