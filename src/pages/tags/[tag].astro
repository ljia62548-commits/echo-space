---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getAllTags, getPublishedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`#${tag}`} description={`所有带有「${tag}」标签的文章。`}>
  <div class="page">
    <header class="page__head">
      <p class="page__index">TAG / {tag.toUpperCase()}</p>
      <h1 class="page__title">#<em>{tag}</em></h1>
      <p class="page__lede">带有这个标签的 {posts.length} 篇文章。</p>
      <div class="page__meta">
        <a class="text-link" href="/tags/">All tags</a>
      </div>
    </header>

    <div class="page__body">
      <div class="post-list">
        {posts.map((post) => <PostRow post={post} />)}
      </div>
    </div>
  </div>
</BaseLayout>
