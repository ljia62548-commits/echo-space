---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';
import {
  getCategoryMeta,
  getPostSlug,
  getPostUrl,
  getPublishedPosts,
  postReadingMinutes,
  type Post,
} from '../../lib/content';
import { formatDate, isoDate } from '../../lib/format';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { category: post.data.category, slug: getPostSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getPublishedPosts();
const position = allPosts.findIndex((item) => item.id === post.id);
const newer = position > 0 ? allPosts[position - 1] : null;
const older = position >= 0 && position < allPosts.length - 1 ? allPosts[position + 1] : null;

const category = getCategoryMeta(post.data.category);
const minutes = postReadingMinutes(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(getPostUrl(post), siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: {
    '@type': 'Person',
    name: site.author,
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
  },
  mainEntityOfPage: canonical,
  url: canonical,
  image: new URL(withBase(post.data.cover ?? site.hero.image), siteUrl).href,
  inLanguage: 'zh-CN',
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover ?? site.hero.image}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
  />

  <div class="read-progress" aria-hidden="true"></div>

  <article class="article-page">
    <header class="article-header">
      <a class="article-back" href={withBase(category?.href ?? '/')}>
        <span aria-hidden="true">←</span> {category?.label ?? 'All writing'}
      </a>

      <div class="article-kicker">
        <span>{category?.label ?? post.data.category}</span>
        <span>·</span>
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        <span>·</span>
        <span>{minutes} min read</span>
      </div>

      <h1 class="article-title">{post.data.title}</h1>
      {post.data.description && <p class="article-description">{post.data.description}</p>}

      <div class="article-meta">
        <span>By {site.author}</span>
        <span>{post.data.tags.map((tag) => `#${tag}`).join('  ')}</span>
        {
          post.data.updated && (
            <span>Updated {formatDate(post.data.updated)}</span>
          )
        }
      </div>
    </header>

    {
      post.data.cover && (
        <figure class="article-cover">
          <img src={withBase(post.data.cover)} alt="" loading="eager" />
        </figure>
      )
    }

    <div class="article-layout">
      <div class="article-body">
        <div class="prose">
          <Content />
        </div>

        <footer class="article-foot">
          <div class="article-tags">
            {post.data.tags.map((tag) => <a class="tag" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}
          </div>
          <div class="article-share">
            <span>Written slowly. Shared quietly.</span>
            <button class="copy-link" type="button" data-copy-link>Copy link ↗</button>
          </div>
        </footer>
      </div>

      {
        toc.length > 0 && (
          <aside class="article-toc" aria-label="文章目录">
            <p class="article-toc__label">On this page</p>
            <ol>
              {toc.map((heading) => (
                <li class={`toc-depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>

    {
      (newer || older) && (
        <nav
          class:list={['article-nav', { 'article-nav--single': !newer || !older }]}
          aria-label="相邻文章"
        >
          {newer && (
            <a class="article-nav__item" href={getPostUrl(newer)}>
              <span class="article-nav__label">← Newer</span>
              <span class="article-nav__title">{newer.data.title}</span>
            </a>
          )}
          {older && (
            <a class="article-nav__item article-nav__item--next" href={getPostUrl(older)}>
              <span class="article-nav__label">Older →</span>
              <span class="article-nav__title">{older.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
