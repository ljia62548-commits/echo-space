---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  categoryNav,
  getPostsByCategory,
  getPostUrl,
  type NavItem,
} from '../../lib/content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  return categoryNav.map((meta) => ({
    params: { category: meta.key },
    props: { meta },
  }));
}

interface Props {
  meta: NavItem;
}

const { meta } = Astro.props;
const posts = await getPostsByCategory(meta.key);
const rawDescription =
  meta.description?.trim() || `关于 ${meta.label}，一些记录还在慢慢整理。`;
const breakAt = rawDescription.search(/[，,、。]/);
const lead = breakAt >= 0 ? rawDescription.slice(0, breakAt).trim() : rawDescription;
const rest = breakAt >= 0 ? rawDescription.slice(breakAt + 1).trim() : '';
---

<BaseLayout title={meta.label} description={meta.description}>
  <div class="page category-page">
    <div class="category-inner">
      <p class:list={['category-note', lead.length > 10 && 'category-note--long']}>
        <span class="category-note__lead">{lead}</span>
        {rest && <span class="category-note__rest">{rest}</span>}
      </p>

      <div class="category-list">
        {
          posts.map((post) => (
            <a class="category-item" href={getPostUrl(post)}>
              <span class="category-item__title">{post.data.title}</span>
              <time class="category-item__date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
