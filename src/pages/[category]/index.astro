---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  categoryNav,
  getPostsByCategory,
  getPostUrl,
  type NavItem,
} from '../../lib/content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  return categoryNav.map((meta) => ({
    params: { category: meta.key },
    props: { meta },
  }));
}

interface Props {
  meta: NavItem;
}

const { meta } = Astro.props;
const posts = await getPostsByCategory(meta.key);
---

<BaseLayout title={meta.label} description={meta.description}>
  <div class="page category-page">
    <div class="category-inner">
      <p class="category-count" aria-label={`共 ${posts.length} 篇文章`}>{posts.length}</p>

      <div class="category-list">
        {
          posts.map((post) => (
            <a class="category-item" href={getPostUrl(post)}>
              <span class="category-item__title">{post.data.title}</span>
              <time class="category-item__date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
