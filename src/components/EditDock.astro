---
import site from '../data/site.json';

const hero = site.hero;
const overlayPercent = Math.round(hero.overlay * 100);
---

<div class="edit-dock" data-edit-dock>
  <div class="edit-dock__panel" data-edit-panel hidden>
    <p class="edit-dock__hint">
      已进入编辑模式。点击带<strong>虚线框</strong>的文字直接修改，完成后保存。
    </p>
    <div class="edit-dock__row">
      <button class="btn btn--solid" type="button" data-edit-save>保存更改</button>
      <button class="btn" type="button" data-edit-cancel>取消</button>
    </div>
    <button class="edit-dock__link" type="button" data-open-wallpaper>
      更换图片 / 调整遮罩 →
    </button>
    <br />
    <a class="edit-dock__link" href="/studio/">打开 Studio 管理文章 →</a>
  </div>

  <button class="edit-dock__toggle" type="button" data-edit-toggle aria-pressed="false">
    编辑页面
  </button>
</div>

<dialog
  class="dialog"
  data-wallpaper-dialog
  aria-labelledby="wallpaper-title"
  data-current-image={hero.image}
  data-current-overlay={hero.overlay}
  data-current-position={hero.position}
>
  <div class="dialog__head">
    <span class="dialog__title" id="wallpaper-title">Hero image</span>
    <button class="dialog__close" type="button" data-close-dialog aria-label="关闭">×</button>
  </div>
  <div class="dialog__body">
    <div class="wallpaper-preview">
      <img
        src={hero.image}
        alt="当前壁纸预览"
        data-wallpaper-preview
        style={`--preview-position: ${hero.position};`}
      />
      <div class="wallpaper-preview__shade" data-preview-shade></div>
    </div>

    <div class="field">
      <label for="wallpaper-file">选择一张图片</label>
      <input
        id="wallpaper-file"
        type="file"
        accept="image/jpeg,image/png,image/webp"
        data-wallpaper-file
      />
      <span class="field__hint">建议横图（16:10），至少 1920px 宽；JPG / PNG / WebP，12MB 以内。</span>
    </div>

    <div class="field">
      <label for="wallpaper-overlay">遮罩浓度 — <span data-overlay-value>{overlayPercent}%</span></label>
      <input
        id="wallpaper-overlay"
        type="range"
        min="0"
        max="80"
        step="1"
        value={overlayPercent}
        data-wallpaper-overlay
      />
      <span class="field__hint">文字看不清时，调高一点；想露出更多画面，调低一点。</span>
    </div>

    <div class="field">
      <label for="wallpaper-position">画面焦点</label>
      <select id="wallpaper-position" data-wallpaper-position>
        <option value="50% 45%" selected={hero.position === '50% 45%'}>偏上 · 默认</option>
        <option value="50% 38%" selected={hero.position === '50% 38%'}>更偏上</option>
        <option value="66% 42%" selected={hero.position === '66% 42%'}>偏右</option>
        <option value="50% 50%" selected={hero.position === '50% 50%'}>居中</option>
        <option value="50% 28%" selected={hero.position === '50% 28%'}>顶部</option>
        <option value="50% 72%" selected={hero.position === '50% 72%'}>偏下</option>
        <option value="28% 50%" selected={hero.position === '28% 50%'}>偏左</option>
        <option value="82% 50%" selected={hero.position === '82% 50%'}>偏右</option>
      </select>
    </div>
  </div>
  <div class="dialog__foot">
    <button class="btn" type="button" data-close-dialog>取消</button>
    <button class="btn btn--solid" type="button" data-apply-wallpaper>应用</button>
  </div>
</dialog>
