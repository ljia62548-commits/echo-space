---
import site from '../data/site.json';

const hero = site.hero;

// 首屏文字用中文逗号分成两列；以后在 Studio 里改句子时，
// 只要保留逗号，就会自动分成两列。
const lines = hero.line
  .split(/[，,]/)
  .map((line) => line.trim())
  .filter(Boolean);
---

<section class="hero hero--full" aria-labelledby="hero-title">
  <div
    class="hero__bg"
    style={`--hero-image: url('${hero.image}'); --hero-position: ${hero.position};`}
    aria-hidden="true"
  ></div>
  <div class="hero__shade" style={`--hero-overlay: ${hero.overlay};`} aria-hidden="true"></div>
  <div class="hero__grade" aria-hidden="true"></div>

  <button class="edit-wallpaper" type="button" data-open-wallpaper>
    <span aria-hidden="true">◉</span> 更换图片
  </button>

  <div class="hero__content">
    <h1
      class="hero__title hero__title--vertical"
      id="hero-title"
      data-bind="site.hero.line"
      data-join="，"
      aria-label={hero.line}
    >
      {
        lines.map((line) => (
          <span class="hero__column">
            <span data-typewriter data-line data-text={line}>{line}</span>
          </span>
        ))
      }
    </h1>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-line"></span>
  </div>
</section>
