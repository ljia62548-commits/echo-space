---
import Brand from './Brand.astro';
import site from '../data/site.json';
import { socialLinks } from '../lib/content';

const path = Astro.url.pathname;
const year = new Date().getFullYear();

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
};
---

<aside class="sidebar" id="site-nav" data-sidebar aria-label="站点导航">
  <Brand />

  <nav class="nav" aria-label="主导航">
    {
      site.nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            class="nav__link"
            href={item.href}
            aria-current={active ? 'page' : undefined}
            data-nav-link
          >
            <span class="nav__label">{item.label}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="sidebar__foot">
    <div class="sidebar__links">
      {socialLinks.map((link) => <a href={link.href} rel="me noopener" target="_blank">{link.label}</a>)}
      <a href="/rss.xml">RSS</a>
      {import.meta.env.DEV && <a class="sidebar__edit" href="/studio/">Edit</a>}
    </div>

    <p class="sidebar__copyright">
      © {year} {site.name}
    </p>
  </div>
</aside>

<header class="mobile-bar" data-mobile-bar>
  <Brand compact />
  <button
    class="mobile-bar__menu"
    type="button"
    data-nav-toggle
    aria-label="打开导航"
    aria-expanded="false"
    aria-controls="site-nav"
  >
    <span></span><span></span><span></span>
  </button>
</header>
