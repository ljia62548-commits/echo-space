---
import Brand from './Brand.astro';
import site from '../data/site.json';
import { socialLinks } from '../lib/content';

const path = Astro.url.pathname;
const year = new Date().getFullYear();

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
};
---

<aside class="sidebar" id="site-nav" data-sidebar aria-label="站点导航">
  <Brand />

  <div class="sidebar-search" data-sidebar-search role="search">
    <div class="sidebar-search__box">
      <svg class="sidebar-search__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="M16 16l4.2 4.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <input
        class="sidebar-search__input"
        type="search"
        placeholder="搜索文章"
        aria-label="搜索文章"
        aria-controls="sidebar-search-panel"
        aria-expanded="false"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <kbd class="sidebar-search__kbd">⌘K</kbd>
      <button class="sidebar-search__clear" type="button" aria-label="清空搜索" data-search-clear hidden>×</button>
    </div>

    <div class="sidebar-search__panel" id="sidebar-search-panel" data-search-panel hidden>
      <p class="sidebar-search__hint" data-search-hint>输入标题、标签或关键词</p>
      <div class="sidebar-search__results" data-search-results></div>
    </div>
  </div>

  <nav class="nav" aria-label="主导航">
    {
      site.nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            class="nav__link"
            href={item.href}
            aria-current={active ? 'page' : undefined}
            data-nav-link
          >
            <span class="nav__label">{item.label}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="sidebar__foot">
    <div class="sidebar__links">
      {socialLinks.map((link) => <a href={link.href} rel="me noopener" target="_blank">{link.label}</a>)}
      <a href="/rss.xml">RSS</a>
      {import.meta.env.DEV && <a class="sidebar__edit" href="/studio/">Edit</a>}
    </div>

    <p class="sidebar__copyright">
      © {year} {site.name}
    </p>
  </div>
</aside>

<header class="mobile-bar" data-mobile-bar>
  <Brand compact />
  <button
    class="mobile-bar__menu"
    type="button"
    data-nav-toggle
    aria-label="打开导航"
    aria-expanded="false"
    aria-controls="site-nav"
  >
    <span></span><span></span><span></span>
  </button>
</header>
